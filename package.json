{
  "name": "luciddream",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "dependencies": {
    "@expo/ui": "~57.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.19",
    "expo-asset": "~57.0.16",
    "expo-audio": "~57.0.4",
    "expo-constants": "~57.0.17",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-glass-effect": "~57.0.1",
    "expo-image": "~57.0.4",
    "expo-keep-awake": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.18",
    "expo-sharing": "~57.0.18",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "js-yaml": "^4.3.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.1",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest-expo": "~57.0.5",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "generate:bundled-scripts": "node ./scripts/sync-bundled-scripts.js",
    "preweb": "npm run generate:bundled-scripts",
    "prebuild:web": "npm run generate:bundled-scripts",
    "prepreview:web": "npm run generate:bundled-scripts",
    "predeploy:web": "npm run generate:bundled-scripts",
    "pretest": "npm run generate:bundled-scripts",
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "clean:build": "node ./scripts/clean-build.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "android:apk:debug": "cd android && gradlew.bat assembleDebug",
    "android:apk:release": "cd android && gradlew.bat assembleRelease -PreactNativeArchitectures=armeabi-v7a,arm64-v8a",
    "web": "expo start --web",
    "demo:web": "EXPO_PUBLIC_DEMO=lock expo start --web",
    "build:web": "expo export --platform web",
    "preview:web": "npm run build:web && npx wrangler@4.129.0 dev",
    "deploy:web": "npm run build:web && npx wrangler@4.129.0 deploy",
    "lint": "expo lint",
    "lint:fix": "expo lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "line-endings:check": "node ./scripts/check-line-endings.js",
    "check": "npm run format:check && npm run line-endings:check && npm run lint && npm run typecheck && npm test -- --runInBand",
    "typecheck": "tsc --noEmit",
    "test": "jest --watchAll=false",
    "test:watch": "jest --watchAll",
    "test:ci": "jest --ci --coverage"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest/setup.js"
    ],
    "moduleNameMapper": {
      "\\.css$": "<rootDir>/jest/style-mock.js"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/.history/"
    ],
    "collectCoverageFrom": [
      "src/lib/**/*.{ts,tsx}",
      "src/components/**/*.{ts,tsx}",
      "src/engine/**/*.{ts,tsx}",
      "src/storage/**/*.{ts,tsx}",
      "src/audio/**/*.{ts,tsx}",
      "src/runtime/**/*.{ts,tsx}",
      "src/session/**/*.{ts,tsx}",
      "src/logging/**/*.{ts,tsx}",
      "!src/engine/testing/**",
      "!src/storage/testing/**"
    ]
  },
  "volta": {
    "node": "22.23.2",
    "npm": "10.9.9"
  }
}
