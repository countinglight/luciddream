# nosniff comes from the /* rule below and is not repeated here.
/content/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=0, must-revalidate

# Asset filenames are not content-hashed, so they must revalidate rather than
# sit in a browser cache after a deployment.
/assets/*
  Cache-Control: public, max-age=0, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
